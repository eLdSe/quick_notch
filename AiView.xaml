<UserControl x:Class="QuickNotchCs.AiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="416" d:DesignWidth="808"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI Variable Display, Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#262629" />
        <SolidColorBrush x:Key="Surface3Brush" Color="#323236" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="AccentHotBrush" Color="#FF375F" />

        <!-- Кнопка действия в заголовке -->
        <Style x:Key="AiHeaderButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#262629" />
            <Setter Property="BorderBrush" Value="#28282B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#323236" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка быстрого вопроса (Prompt Chip) -->
        <Style x:Key="PromptChipButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#262629" />
            <Setter Property="BorderBrush" Value="#28282B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#323236" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#0A84FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Основная плашка Аэро -->
    <Border Background="{StaticResource SurfaceBrush}" 
            BorderBrush="{StaticResource BorderSubtleBrush}" 
            BorderThickness="1" 
            CornerRadius="22" 
            Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Верхняя панель заголовка -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Аэро" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ProviderModelBadge" Text="Gemini 2.5 Flash" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AiHeaderButton}" Margin="0,0,6,0" Click="OnNewChatClick">
                        <TextBlock Text="💬 Новый чат" />
                    </Button>
                    <Button Style="{StaticResource AiHeaderButton}" Margin="0,0,6,0" Click="OnToggleHistoryClick">
                        <TextBlock Text="📜 История" />
                    </Button>
                    <Button Style="{StaticResource AiHeaderButton}" Click="OnApiKeyClick">
                        <TextBlock Text="⚙️ API Ключ" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Центральная область чата и истории -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <!-- Прокручиваемый список сообщений чата -->
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MessagesPanel" />
                </ScrollViewer>

                <!-- Приветственный экран, если сообщений нет -->
                <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🤖" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Чем могу помочь сегодня?" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Задайте любой вопрос или выберите быструю подсказку" FontSize="11.5" 
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,16" />

                    <Button Style="{StaticResource PromptChipButton}" Click="OnPromptChipClick" 
                            Content="💡 Объясни квантовые вычисления простыми словами" />
                    <Button Style="{StaticResource PromptChipButton}" Click="OnPromptChipClick" 
                            Content="📝 Напиши вежливый ответ коллеге на рабочее письмо" />
                    <Button Style="{StaticResource PromptChipButton}" Click="OnPromptChipClick" 
                            Content="💻 Напиши C# метод для подсчёта хэша SHA-256 файла" />
                </StackPanel>

                <!-- Боковая шторка истории диалогов -->
                <Border x:Name="HistoryDrawer" Background="#1C1C1E" BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="1" CornerRadius="16" Width="280" HorizontalAlignment="Right" 
                        Padding="14" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="История бесед" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource AiHeaderButton}" HorizontalAlignment="Right" Padding="6,2" Click="OnCloseHistoryClick">
                                <TextBlock Text="✕" FontSize="10" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="HistoryListPanel" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Нижняя панель ввода вопроса -->
            <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                    CornerRadius="18" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Поле ввода текста -->
                    <TextBox Grid.Column="0" x:Name="PromptTextBox" Background="Transparent" BorderThickness="0" 
                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" 
                             VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="64" 
                             PreviewKeyDown="OnPromptKeyDown" />

                    <!-- Текст-подсказка (Placeholder) -->
                    <TextBlock Grid.Column="0" x:Name="PromptPlaceholder" Text="Спросите Аэро о чём угодно... (Enter для отправки)" 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" />

                    <!-- Кнопка Вставить из буфера -->
                    <Button Grid.Column="1" Style="{StaticResource AiHeaderButton}" Padding="8,4" 
                            ToolTip="Вставить из буфера" Click="OnPasteClick">
                        <TextBlock Text="📋" FontSize="11" />
                    </Button>

                    <!-- Кнопка Отправить -->
                    <Button Grid.Column="3" x:Name="SendButton" Width="34" Height="34" Cursor="Hand" Click="OnSendClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{StaticResource AccentBrush}" CornerRadius="17">
                                    <TextBlock Text="➔" FontSize="13" FontWeight="Bold" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#0077ED" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

