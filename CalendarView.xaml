<UserControl x:Class="QuickNotchCs.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="416" d:DesignWidth="808"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI Variable Display, Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#262629" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="AccentHotBrush" Color="#FF375F" />

        <!-- Стиль кнопки навигации -->
        <Style x:Key="CalNavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#262629" />
            <Setter Property="BorderBrush" Value="#28282B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#323236" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Bento Grid из 2 колонок -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== ЛЕВАЯ КОЛОНКА: СЕТКА КАЛЕНДАРЯ ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                CornerRadius="22" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Шапка месяца и кнопки навигации -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="MonthTitleText" Text="Октябрь 2026" FontSize="16" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CalNavButton}" Width="28" Height="26" Click="OnPrevMonthClick">
                            <TextBlock Text="‹" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource CalNavButton}" Margin="4,0,4,0" Click="OnTodayClick">
                            <TextBlock Text="Сегодня" FontSize="10.5" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource CalNavButton}" Width="28" Height="26" Click="OnNextMonthClick">
                            <TextBlock Text="›" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Дни недели (Пн, Вт, Ср, Чт, Пт, Сб, Вс) -->
                <UniformGrid Grid.Row="1" Rows="1" Columns="7" Margin="0,0,0,8">
                    <TextBlock Text="ПН" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="ВТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="СР" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="ЧТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="ПТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="СБ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="ВС" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </UniformGrid>

                <!-- 3. Дни месяца (Сетка 6x7) -->
                <UniformGrid Grid.Row="2" x:Name="CalendarDaysGrid" Rows="6" Columns="7" />
            </Grid>
        </Border>

        <!-- ==================== ПРАВАЯ КОЛОНКА: ЗАДАЧИ НА ВЫБРАННЫЙ ДЕНЬ ==================== -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                CornerRadius="22" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Шапка дня и кнопка добавления -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedDayText" Text="28 октября, среда" FontSize="14" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SelectedDaySubtext" Text="Задачи и напоминания" FontSize="10" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource CalNavButton}" HorizontalAlignment="Right" Padding="10,5" Click="OnAddNoteClick">
                        <TextBlock Text="➕ Задача" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Button>
                </Grid>

                <!-- Список задач на выбранный день -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DayNotesPanel" />
                </ScrollViewer>

                <!-- Заглушка, если нет задач -->
                <StackPanel x:Name="NoNotesPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📅" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="На этот день нет задач" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Нажмите «➕ Задача», чтобы добавить" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Статистика года внизу -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                    <TextBlock x:Name="YearStatsText" Text="День 301 из 365  ·  До Нового года: 64 дн." FontSize="10.5" 
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

