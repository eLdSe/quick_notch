<UserControl x:Class="QuickNotchCs.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400"
        d:DesignWidth="800"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI Variable Display, Segoe UI">

    <UserControl.Resources>
        <!-- Базовый стиль карточки Liquid Glass с тонкой полированной гранью сверху -->
        <Style x:Key="AppleGlassCardStyle"
                TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="18"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0"
                            EndPoint="0,1">
                        <GradientStop Color="#38FFFFFF"
                                Offset="0"/>
                        <GradientStop Color="#10FFFFFF"
                                Offset="0.5"/>
                        <GradientStop Color="#06FFFFFF"
                                Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль современной плитки-кнопки переключателя (Wi-Fi, Bluetooth и т.д.) -->
        <Style x:Key="AppleTileButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль главной кнопки Play/Pause (Apple Red Glow) -->
        <Style x:Key="PrimaryMediaPlayPauseStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg"
                                    Fill="{TemplateBinding Background}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="14"
                                            ShadowDepth="2"
                                            Opacity="0.45"
                                            Color="#E53935"
                                            RenderingBias="Performance"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="bg"
                                        Property="Fill"
                                        Value="{DynamicResource AccentHotBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="bg"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль круглой кнопки медиа -->
        <Style x:Key="MediaCircleButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="#2C2C2E"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg"
                                    Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="bg"
                                        Property="Fill"
                                        Value="#3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="bg"
                                        Property="Fill"
                                        Value="#48484A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль тактильного слайдера-капсулы в стиле macOS Control Center -->
        <!-- Стиль тактильного слайдера в стиле macOS Control Center -->
        <Style x:Key="AppleCapsuleSliderStyle"
                TargetType="Slider">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Height"
                    Value="18"/>
            <Setter Property="IsMoveToPointEnabled"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="18" Background="Transparent">
                            <!-- Фоновая дорожка -->
                            <Border Height="7"
                                    CornerRadius="3.5"
                                    Background="#22FFFFFF"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="3.5,0,0,3.5"
                                                        Height="7"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Width="14"
                                                        Height="14"
                                                        Background="White"
                                                        CornerRadius="7">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4"
                                                                ShadowDepth="1"
                                                                Opacity="0.4"
                                                                Color="Black"
                                                                RenderingBias="Performance"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка быстрых действий (иконка сверху, подпись и статус снизу) -->
        <Style x:Key="QuickTileButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter/>
                            <Border x:Name="hover"
                                    CornerRadius="14"
                                    Background="#14FFFFFF"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="hover"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="hover"
                                        Property="Opacity"
                                        Value="1"/>
                                <Setter TargetName="hover"
                                        Property="Background"
                                        Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Сетка 2x2 в стиле макета: быстрые действия, плеер, громкость/яркость, система -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. СЕЙЧАС ИГРАЕТ (МЕДИА) ==================== -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource AppleGlassCardStyle}"
                Padding="16,10,16,10"
                Cursor="Hand"
                MouseLeftButtonUp="OnMediaCardClick"
                ToolTip="Открыть плеер">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Grid Grid.Row="0"
                        Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <TextBlock x:Name="NowPlayingTitleText"
                                Text="Сейчас играет"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="MediaAppBadge"
                            Text=""
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Обложка, название, автор -->
                <Grid Grid.Row="1"
                        VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="56"
                            Height="56"
                            CornerRadius="10"
                            Background="#262629"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="♫"
                                    FontSize="22"
                                    Foreground="#8E8E93"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Image x:Name="AlbumCoverImage"
                                    Stretch="UniformToFill"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                        <TextBlock x:Name="TrackTitleText"
                                Text="Не воспроизводится"
                                FontSize="15"
                                FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackArtistText"
                                Text="Включите музыку в плеере"
                                FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                Margin="0,3,0,0"
                                TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Прогресс трека -->
                <Grid Grid.Row="2"
                        Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MediaPosText"
                            Grid.Column="0"
                            Text="0:00"
                            FontSize="10"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            VerticalAlignment="Center"/>
                    <ProgressBar x:Name="MediaProgress"
                            Grid.Column="1"
                            Height="4"
                            Maximum="1"
                            Value="0"
                            Margin="8,0,8,0"
                                 Foreground="{DynamicResource AccentBrush}"
                            Background="#33FFFFFF"
                            BorderThickness="0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="MediaDurText"
                            Grid.Column="2"
                            Text="0:00"
                            FontSize="10"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Кнопки управления -->
                <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,4,0,0">
                    <Button Width="32"
                            Height="32"
                            Style="{StaticResource MediaCircleButtonStyle}"
                            Background="Transparent"
                            Margin="0,0,16,0"
                            Click="OnMediaPrevClick">
                        <TextBlock Text="&#xE892;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"/>
                    </Button>
                    <Button x:Name="PlayPauseButton"
                            Width="40"
                            Height="40"
                            Style="{StaticResource PrimaryMediaPlayPauseStyle}"
                            Click="OnMediaPlayPauseClick">
                        <Grid HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Path x:Name="HomePauseIcon"
                                    Fill="#FFFFFF"
                                  Data="M 0,0 L 3.2,0 L 3.2,12 L 0,12 Z M 6.8,0 L 10,0 L 10,12 L 6.8,12 Z"
                                  Width="10"
                                    Height="12"
                                    Stretch="Uniform"
                                    Visibility="Visible"
                                    SnapsToDevicePixels="True"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="HomePauseScale"
                                            ScaleX="1"
                                            ScaleY="1"/>
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="HomePlayIcon"
                                    Fill="#FFFFFF"
                                  Data="M 0.5,0 L 10.5,6 L 0.5,12 Z"
                                  Width="10"
                                    Height="12"
                                    Stretch="Uniform"
                                    Margin="1,0,0,0"
                                    Visibility="Collapsed"
                                    SnapsToDevicePixels="True"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="HomePlayScale"
                                            ScaleX="1"
                                            ScaleY="1"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Width="32"
                            Height="32"
                            Style="{StaticResource MediaCircleButtonStyle}"
                            Background="Transparent"
                            Margin="16,0,0,0"
                            Click="OnMediaNextClick">
                        <TextBlock Text="&#xE893;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. БЫСТРЫЕ ДЕЙСТВИЯ (СИСТЕМА) ==================== -->
        <Border Grid.Row="0"
                Grid.Column="2"
                Style="{StaticResource AppleGlassCardStyle}"
                Padding="14,10,14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка по умолчанию -->
                <StackPanel x:Name="QuickDefaultHeader"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="2,0,0,7">
                    <TextBlock Text="&#xE945;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickTitleText"
                            Text="Быстрые действия"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Шапка встроенного меню выбора Wi-Fi / Bluetooth -->
                <Grid x:Name="QuickSubMenuHeader"
                        Grid.Row="0"
                        Margin="0,0,0,6"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AppleTileButtonStyle}"
                                Click="OnQuickSubMenuBackClick"
                                ToolTip="Назад к быстрым действиям">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE76B;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0"/>
                                <TextBlock x:Name="QuickSubMenuBackText"
                                        Text="Назад"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="QuickSubMenuTitleText"
                                Text="Сети Wi-Fi"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0"/>
                    </StackPanel>

                    <Button Style="{StaticResource AppleTileButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnQuickSubMenuRefreshClick"
                            ToolTip="Обновить список">
                        <TextBlock Text="&#xE72C;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Двухэтажная сетка 2×3 в стиле macOS Control Center -->
                <Grid x:Name="QuickGridPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Wi-Fi (Ряд 1, Кол 1) — Раздельная кнопка со стрелкой › как в Windows 11 -->
                    <Border x:Name="WifiIndicator"
                            Grid.Row="0" Grid.Column="0"
                            CornerRadius="13"
                            BorderThickness="1.2"
                            BorderBrush="Transparent"
                            Background="#14FFFFFF"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource QuickTileButtonStyle}"
                                    Click="OnWifiClick"
                                    ToolTip="Включить / Выключить Wi-Fi">
                                <Grid VerticalAlignment="Center" Margin="7,2,3,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WifiIcon"
                                            Grid.Column="0"
                                            Text="&#xE701;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="15"
                                            Foreground="White"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="WifiTitleText"
                                                Text="Wi-Fi"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="WifiStatusText"
                                                Text="Вкл"
                                                FontSize="9"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Margin="0,1,0,0"
                                                TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Rectangle Grid.Column="1" Fill="#26FFFFFF" Margin="0,8"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource QuickTileButtonStyle}"
                                    Click="OnWifiChevronClick"
                                    ToolTip="Выбрать сеть Wi-Fi">
                                <TextBlock Text="&#xE76C;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="9.5"
                                        Foreground="#D8FFFFFF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 2. Bluetooth (Ряд 1, Кол 2) — Раздельная кнопка со стрелкой › как в Windows 11 -->
                    <Border x:Name="BtIndicator"
                            Grid.Row="0" Grid.Column="2"
                            CornerRadius="13"
                            BorderThickness="1.2"
                            BorderBrush="Transparent"
                            Background="#14FFFFFF"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource QuickTileButtonStyle}"
                                    Click="OnBluetoothClick"
                                    ToolTip="Включить / Выключить Bluetooth">
                                <Grid VerticalAlignment="Center" Margin="7,2,3,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BtIcon"
                                            Grid.Column="0"
                                            Text="&#xE702;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="15"
                                            Foreground="White"
                                            VerticalAlignment="Center"
                                            Margin="0,0,5,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="BtTitleText"
                                                Text="Bluetooth"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="BtStatusText"
                                                Text="Вкл"
                                                FontSize="9"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Margin="0,1,0,0"
                                                TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Rectangle Grid.Column="1" Fill="#26FFFFFF" Margin="0,8"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource QuickTileButtonStyle}"
                                    Click="OnBluetoothChevronClick"
                                    ToolTip="Выбрать устройство Bluetooth">
                                <TextBlock Text="&#xE76C;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="9.5"
                                        Foreground="#D8FFFFFF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 3. Скриншот (Ряд 1, Кол 3) -->
                    <Button Grid.Row="0" Grid.Column="4"
                            Style="{StaticResource QuickTileButtonStyle}"
                            Click="OnSnipClick"
                            ToolTip="Сделать скриншот области экрана (Win + Shift + S)">
                        <Border x:Name="SnipIndicator"
                                CornerRadius="13"
                                BorderThickness="1.2"
                                BorderBrush="Transparent"
                                Background="#14FFFFFF"
                                Padding="9,4">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SnipIcon"
                                        Grid.Column="0"
                                        Text="&#xE926;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SnipTitleText"
                                            Text="Снимок"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SnipStatusText"
                                            Text="Экран"
                                            FontSize="9.5"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Margin="0,1,0,0"
                                            TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- 4. Помодоро (Ряд 2, Кол 1) -->
                    <Button Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource QuickTileButtonStyle}"
                            Click="OnPomodoroTileClick"
                            MouseRightButtonUp="OnPomodoroTileRightClick"
                            ToolTip="ЛКМ: Открыть Помодоро  ·  ПКМ: Старт / Пауза">
                        <Border x:Name="PomodoroIndicator"
                                CornerRadius="13"
                                BorderThickness="1.2"
                                BorderBrush="Transparent"
                                Background="#14FFFFFF"
                                Padding="9,4">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PomodoroIcon"
                                        Grid.Column="0"
                                        Text="&#xE916;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Margin="0,0,7,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PomodoroTitleText"
                                            Text="Помодоро"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PomodoroStatusText"
                                            Text="25:00"
                                            FontSize="9.5"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Margin="0,1,0,0"
                                            TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- 5. Заметки / Задачи (Ряд 2, Кол 2) -->
                    <Button Grid.Row="2" Grid.Column="2"
                            Style="{StaticResource QuickTileButtonStyle}"
                            Click="OnNotesTileClick"
                            ToolTip="Открыть заметки и задачи в календаре">
                        <Border x:Name="NotesIndicator"
                                CornerRadius="13"
                                BorderThickness="1.2"
                                BorderBrush="Transparent"
                                Background="#14FFFFFF"
                                Padding="9,4">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NotesIcon"
                                        Grid.Column="0"
                                        Text="&#xE70B;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="NotesTitleText"
                                            Text="Заметки"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="NotesStatusText"
                                            Text="Открыть"
                                            FontSize="9.5"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Margin="0,1,0,0"
                                            TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- 6. Файлы / Полка (Ряд 2, Кол 3) -->
                    <Button Grid.Row="2" Grid.Column="4"
                            Style="{StaticResource QuickTileButtonStyle}"
                            AllowDrop="True"
                            DragOver="OnFilesTileDragOver"
                            Drop="OnFilesTileDrop"
                            Click="OnFilesTileClick"
                            MouseRightButtonUp="OnFilesTileRightClick"
                            ToolTip="ЛКМ: Открыть файлы  ·  ПКМ или перетаскивание: Добавить файл">
                        <Border x:Name="FilesIndicator"
                                CornerRadius="13"
                                BorderThickness="1.2"
                                BorderBrush="Transparent"
                                Background="#14FFFFFF"
                                Padding="9,4">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FilesIcon"
                                        Grid.Column="0"
                                        Text="&#xED25;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="FilesTitleText"
                                            Text="Файлы"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="FilesStatusText"
                                            Text="Полка"
                                            FontSize="9.5"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Margin="0,1,0,0"
                                            TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>

                <!-- Встроенное всплывающее меню выбора сетей Wi-Fi / устройств Bluetooth -->
                <Border x:Name="QuickSubMenuPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#12FFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="6,4">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="QuickSubMenuItemsPanel"/>
                        </ScrollViewer>
                        <TextBlock x:Name="QuickSubMenuEmptyText"
                                Text="Поиск..."
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 3. ЗВУК И АУДИО (МЕДИА) ==================== -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource AppleGlassCardStyle}"
                Padding="16,12,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок (клик открывает настройки звука) -->
                <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        Background="Transparent"
                        MouseLeftButtonUp="OnSoundHeaderClick"
                        ToolTip="Открыть настройки звука">
                    <TextBlock Text="&#xE767;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock x:Name="VolumeTitleText"
                            Text="Звук и аудио"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                        VerticalAlignment="Center">
                    <!-- Громкость: Иконка и подпись сверху, слайдер снизу -->
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="VolumeIcon"
                                        Text="&#xE767;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="13.5"
                                        Foreground="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,7,0"/>
                                <TextBlock x:Name="VolumeLabelText"
                                        Text="Динамики"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="VolumePercentText"
                                    Text="70%"
                                    FontSize="11.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" x:Name="VolumeCapsuleContainer"
                                Height="22"
                                Background="Transparent"
                                Cursor="Hand"
                                PreviewMouseDown="OnVolumeCapsuleMouseDown"
                                PreviewMouseMove="OnVolumeCapsuleMouseMove"
                                PreviewMouseUp="OnVolumeCapsuleMouseUp">
                            <Slider x:Name="VolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="70"
                                    IsMoveToPointEnabled="True"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource AppleCapsuleSliderStyle}"
                                    ValueChanged="OnVolumeSliderChanged"/>
                        </Grid>
                    </Grid>

                    <!-- Кнопка переключения без звука (Mute) -->
                    <Button Style="{StaticResource AppleTileButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="OnMuteToggleClick"
                            Cursor="Hand">
                        <Border CornerRadius="12" Background="#14FFFFFF" Padding="10,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="MuteToggleIcon" Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="MuteToggleText" Text="Звук включен" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 4. ДИСПЛЕЙ И СИСТЕМА ==================== -->
        <Border Grid.Row="2"
                Grid.Column="2"
                Style="{StaticResource AppleGlassCardStyle}"
                Padding="14,10,14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,6"
                        Cursor="Hand"
                        Background="Transparent"
                        MouseLeftButtonUp="OnSystemCardClick"
                        ToolTip="Открыть системный монитор">
                    <TextBlock Text="&#xE706;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock x:Name="SystemTitleText"
                            Text="Дисплей и Система"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Яркость дисплея: Иконка, подпись и слайдер -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="BrightnessIcon"
                                        Text="&#xE706;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"/>
                                <TextBlock x:Name="BrightnessLabelText"
                                        Text="Яркость дисплея"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="BrightnessPercentText"
                                    Text="100%"
                                    FontSize="11.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" x:Name="BrightnessCapsuleContainer"
                                Height="18"
                                Background="Transparent"
                                Cursor="Hand"
                                PreviewMouseDown="OnBrightnessCapsuleMouseDown"
                                PreviewMouseMove="OnBrightnessCapsuleMouseMove"
                                PreviewMouseUp="OnBrightnessCapsuleMouseUp">
                            <Slider x:Name="BrightnessSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    IsMoveToPointEnabled="True"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource AppleCapsuleSliderStyle}"
                                    ValueChanged="OnBrightnessSliderChanged"/>
                        </Grid>
                    </Grid>

                    <!-- Погода и кольца активности -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Погода (клик открывает прогноз) -->
                        <Border Grid.Column="0"
                                CornerRadius="12"
                                Cursor="Hand"
                                Background="Transparent"
                                Padding="4,2"
                                MouseLeftButtonUp="OnWeatherCardClick"
                                ToolTip="Открыть прогноз погоды">
                            <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="WeatherTempText"
                                        Text="+21°"
                                        FontSize="21"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        HorizontalAlignment="Center"/>
                                <TextBlock x:Name="WeatherCityText"
                                        Text="Ясно"
                                        FontSize="10"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <Rectangle Grid.Column="1"
                                Fill="#1EFFFFFF"
                                Margin="0,4"/>

                        <!-- Кольца активности CPU / RAM (Apple Activity Rings) -->
                        <Grid Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Кольцо 1: CPU -->
                            <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnSystemCardClick"
                                    ToolTip="Загрузка процессора">
                                <Grid Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center">
                                    <Ellipse Stroke="#22FFFFFF"
                                            StrokeThickness="3"
                                            Width="32"
                                            Height="32"/>
                                    <Path x:Name="CpuRingPath"
                                            Width="32"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="None"
                                            Stroke="{DynamicResource AccentBrush}"
                                            StrokeThickness="3"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            SnapsToDevicePixels="True"/>
                                    <TextBlock x:Name="CpuPercentText"
                                            Text="3%"
                                            FontSize="8.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="CpuLabelText"
                                        Text="CPU"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Кольцо 2: RAM -->
                            <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnSystemCardClick"
                                    ToolTip="Использование оперативной памяти">
                                <Grid Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center">
                                    <Ellipse Stroke="#22FFFFFF"
                                            StrokeThickness="3"
                                            Width="32"
                                            Height="32"/>
                                    <Path x:Name="RamRingPath"
                                            Width="32"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="None"
                                            Stroke="{DynamicResource AccentHotBrush}"
                                            StrokeThickness="3"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            SnapsToDevicePixels="True"/>
                                    <TextBlock x:Name="RamPercentText"
                                            Text="42%"
                                            FontSize="8.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="RamLabelText"
                                        Text="RAM"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
