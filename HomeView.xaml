<UserControl x:Class="QuickNotchCs.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI Variable Display, Segoe UI">

    <UserControl.Resources>
        <!-- Стили цветов темы Apple Dark Glass -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2C2C2E" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#262629" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3C" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="AccentHotBrush" Color="#FF375F" />
        <SolidColorBrush x:Key="GreenBrush" Color="#30D158" />

        <!-- Стиль современной плитки-кнопки переключателя (Wi-Fi, Bluetooth и т.д.) -->
        <Style x:Key="AppleTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль круглой кнопки медиа -->
        <Style x:Key="MediaCircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#48484A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для аккуратного ползунка Apple Slider -->
        <Style x:Key="AppleSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="36">
                            <!-- Задняя дорожка -->
                            <Border x:Name="TrackBg" Background="#2C2C2E" CornerRadius="18" Height="36" />
                            <!-- Заполненная часть дорожки -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#0A84FF" CornerRadius="18,0,0,18" Height="36" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="30" Height="30" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Сетка Apple Bento Grid (2 колонки x 2 ряда) -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="175" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. КАРТОЧКА СВЯЗИ (ВЕРХНИЙ ЛЕВЫЙ БЛОК) ==================== -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="20" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Разделители ячеек -->
                <Rectangle Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Fill="{StaticResource BorderSubtleBrush}" Margin="0,10" />
                <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Fill="{StaticResource BorderSubtleBrush}" Margin="10,0" />

                <!-- Ячейка: Wi-Fi -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AppleTileButtonStyle}" Click="OnWifiClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="WifiIndicator" Width="36" Height="36" CornerRadius="18" Background="#0A84FF" Margin="4,0,10,0">
                            <TextBlock Text="📶" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Wi-Fi" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="WifiStatusText" Text="Вкл" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Ячейка: Bluetooth -->
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource AppleTileButtonStyle}" Click="OnBluetoothClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BtIndicator" Width="36" Height="36" CornerRadius="18" Background="#0A84FF" Margin="4,0,10,0">
                            <TextBlock Text="ᛒ" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bluetooth" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="BtStatusText" Text="Вкл" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Ячейка: Тёмная тема -->
                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource AppleTileButtonStyle}" Click="OnThemeClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#2C2C2E" Margin="4,0,10,0">
                            <TextBlock Text="🌙" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Тема" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="ThemeStatusText" Text="Тёмная" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Ячейка: Бодрствование -->
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource AppleTileButtonStyle}" Click="OnKeepAwakeClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AwakeIndicator" Width="36" Height="36" CornerRadius="18" Background="#2C2C2E" Margin="4,0,10,0">
                            <TextBlock Text="☕" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Бодрствование" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="AwakeStatusText" Text="Выкл" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ==================== 2. КАРТОЧКА МЕДИА (ВЕРХНИЙ ПРАВЫЙ БЛОК) ==================== -->
        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="20" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок карточки медиа -->
                <Grid Grid.Row="0">
                    <TextBlock Text="СЕЙЧАС ИГРАЕТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="MediaAppBadge" Text="Spotify" FontSize="10" FontWeight="SemiBold" 
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                </Grid>

                <!-- Информация о треке и обложка -->
                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Обложка альбома -->
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="#262629">
                        <Image x:Name="AlbumCoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Название и автор -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="TrackTitleText" Text="Не воспроизводится" FontSize="14" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TrackArtistText" Text="Включите музыку в плеере" FontSize="11.5" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Кнопки управления воспроизведением -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Style="{StaticResource MediaCircleButtonStyle}" Margin="0,0,16,0" Click="OnMediaPrevClick">
                        <TextBlock Text="⏮" FontSize="11" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Width="38" Height="38" Background="#0A84FF" Style="{StaticResource MediaCircleButtonStyle}" Click="OnMediaPlayPauseClick">
                        <TextBlock x:Name="PlayPauseIcon" Text="▶" FontSize="14" Margin="2,0,0,0" />
                    </Button>
                    <Button Width="32" Height="32" Style="{StaticResource MediaCircleButtonStyle}" Margin="16,0,0,0" Click="OnMediaNextClick">
                        <TextBlock Text="⏭" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 3. КАРТОЧКА СЛАЙДЕРОВ (НИЖНИЙ ЛЕВЫЙ БЛОК) ==================== -->
        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="20" Padding="18,14">
            <StackPanel VerticalAlignment="Center">
                <!-- ГРОМКОСТЬ -->
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="ГРОМКОСТЬ ДИНАМИКОВ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="VolumePercentText" Text="70%" FontSize="11.5" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="70" 
                        Style="{StaticResource AppleSliderStyle}" ValueChanged="OnVolumeSliderChanged" />

                <!-- Разделитель -->
                <Rectangle Fill="{StaticResource BorderSubtleBrush}" Height="1" Margin="0,14,0,14" />

                <!-- ЯРКОСТЬ ДИСПЛЕЯ -->
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="ЯРКОСТЬ ДИСПЛЕЯ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="BrightnessPercentText" Text="100%" FontSize="11.5" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100" 
                        Style="{StaticResource AppleSliderStyle}" ValueChanged="OnBrightnessSliderChanged" />
            </StackPanel>
        </Border>

        <!-- ==================== 4. КАРТОЧКА СИСТЕМЫ И ПОГОДЫ (НИЖНИЙ ПРАВЫЙ БЛОК) ==================== -->
        <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="20" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="СИСТЕМА И ПОГОДА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />

                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Погода -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="WeatherTempText" Text="+21°" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WeatherCityText" Text="Ясно" FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>

                    <Rectangle Grid.Column="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,6" />

                    <!-- Ресурсы CPU/RAM -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock x:Name="CpuText" Text="CPU: 3%" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <ProgressBar x:Name="CpuBar" Height="4" Value="3" Maximum="100" Margin="0,4,0,8" Foreground="{StaticResource AccentBrush}" Background="#2C2C2E" BorderThickness="0" />

                        <TextBlock x:Name="RamText" Text="RAM: 42%" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <ProgressBar x:Name="RamBar" Height="4" Value="42" Maximum="100" Margin="0,4,0,0" Foreground="{StaticResource AccentHotBrush}" Background="#2C2C2E" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
