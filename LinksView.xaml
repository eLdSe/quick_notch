<UserControl x:Class="QuickNotchCs.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="416" d:DesignWidth="808"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI Variable Display, Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#262629" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="AccentHotBrush" Color="#FF375F" />

        <!-- Стиль фильтра ссылок -->
        <Style x:Key="LinkFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="#262629" BorderBrush="#28282B" BorderThickness="1" CornerRadius="10" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0A84FF" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#0A84FF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="#323236" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки действия -->
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#262629" />
            <Setter Property="BorderBrush" Value="#28282B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#323236" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Основная плашка LaunchDeck -->
    <Border Style="{StaticResource AppleGlassCardStyle}" Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Верхняя панель: Заголовок + Фильтры + Кнопки добавления -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock x:Name="LinksTitleText" Text="Быстрый запуск" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" /></StackPanel>
                    <RadioButton x:Name="FilterAllRadio" Style="{StaticResource LinkFilterRadioStyle}" Content="Все" IsChecked="True" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterWebRadio" Style="{StaticResource LinkFilterRadioStyle}" Content="Сайты" Margin="4,0,0,0" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterFolderRadio" Style="{StaticResource LinkFilterRadioStyle}" Content="Папки" Margin="4,0,0,0" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterAppRadio" Style="{StaticResource LinkFilterRadioStyle}" Content="Программы" Margin="4,0,0,0" Checked="OnFilterChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource HeaderActionButton}" Margin="0,0,6,0" Click="OnAddUrlClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock x:Name="AddUrlButtonText" Text="Ссылка" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderActionButton}" Margin="0,0,6,0" Click="OnAddFileClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock x:Name="AddFileButtonText" Text="Файл / Приложение" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="EditModeButton" Style="{StaticResource HeaderActionButton}" Click="OnToggleEditClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock x:Name="EditModeButtonText" Text="Изменить" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Сетка карточек ссылок -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="LinksGridPanel" Margin="0,0,0,8" />
            </ScrollViewer>

            <!-- 3. Нижняя плашка: Популярные шаблоны в 1 клик -->
            <Border Grid.Row="2" Style="{StaticResource AppleGlassWellStyle}" Padding="14,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PresetsTitleText" Grid.Column="0" Text="Добавить в 1 клик:" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <WrapPanel Grid.Column="1" x:Name="PresetsPanel" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

