<UserControl x:Class="QuickNotchCs.NotchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, BlinkMacSystemFont">

    <UserControl.Resources>
        <SolidColorBrush x:Key="NotchBgBrush" Color="#000000" />
        <SolidColorBrush x:Key="NotchBorderBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="WeatherCloudBrush" Color="#9A9AA0" />
        <SolidColorBrush x:Key="GreenBrush" Color="#30D158" />
    </UserControl.Resources>

    <!-- Внешний контейнер с благородной мягкой тенью Apple: глубокий естественный силуэт без красного света -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.Effect>
            <DropShadowEffect x:Name="NotchShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000" RenderingBias="Performance" />
        </Grid.Effect>

        <!-- Левое вогнутое ушко (MacBook Notch Fillet) -->
        <Path x:Name="LeftEar" 
              Data="M 0,0 L 16,0 L 16,16 Q 16,0 0,0 Z" 
              Fill="#000000" 
              HorizontalAlignment="Left" 
              VerticalAlignment="Top" 
              Margin="-16,0,0,0"
              SnapsToDevicePixels="True" />

        <!-- Правое вогнутое ушко (MacBook Notch Fillet) -->
        <Path x:Name="RightEar" 
              Data="M 0,0 L 0,16 Q 0,0 16,0 L 16,0 Z" 
              Fill="#000000" 
              HorizontalAlignment="Right" 
              VerticalAlignment="Top" 
              Margin="0,0,-16,0"
              SnapsToDevicePixels="True" />

        <!-- Основная капсула свёрнутого выреза (Dynamic Island / MacBook Notch) -->
        <Border x:Name="NotchCapsule" 
                Background="#000000" 
                BorderBrush="#1C1C1E" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,18,18" 
                Height="38" 
                Width="215"
                Padding="12,0" 
                Cursor="Hand"
                HorizontalAlignment="Center" 
                VerticalAlignment="Top"
                MouseLeftButtonUp="OnNotchClick"
                MouseEnter="OnNotchMouseEnter"
                MouseLeave="OnNotchMouseLeave"
                SnapsToDevicePixels="True">

            <Grid VerticalAlignment="Center">
                <!-- 1. РЕЖИМ ПЛЕЕРА (когда играет музыка: двухстрочная компоновка строго по фото) -->
                <Grid x:Name="MediaModeGrid" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="OnMediaNotchClick" ToolTip="Открыть плеер" Margin="2,0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="MediaModeScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <!-- 0: Обложка альбома -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <!-- 2: Название, исполнитель и кнопки управления -->
                        <ColumnDefinition Width="*" MinWidth="130" MaxWidth="220" />
                        <ColumnDefinition Width="10" />
                        <!-- 4: Эквалайзер и опции -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Обложка альбома (крупный квадрат со скругленными углами) -->
                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="#1C1C1E" BorderBrush="#26FFFFFF" BorderThickness="0.8" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="♫" FontSize="18" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="MiniCoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <!-- Инфо о треке + кнопки прямо под ним -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Название трека и исполнитель -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock x:Name="MiniTrackTitle" Text="Трек" FontSize="12.5" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MiniTrackArtist" Text="Исполнитель" FontSize="10" Margin="0,1,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Переключатели медиа: Предыдущий, Play/Pause, Следующий -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Кнопка Prev -->
                            <Border x:Name="MiniPrevBtn" Width="22" Height="22" CornerRadius="11" Background="Transparent" 
                                    Cursor="Hand" Margin="0,0,5,0" VerticalAlignment="Center"
                                    MouseLeftButtonUp="OnMediaPrevClick" ToolTip="Предыдущий трек">
                                <Path Fill="#C8C8CD" Data="M 0,0.5 L 2,0.5 L 2,9.5 L 0,9.5 Z M 9,0.5 L 2.5,5 L 9,9.5 Z" 
                                      Width="9" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                            </Border>

                            <!-- Кнопка Play/Pause в кружке с акцентным цветом темы (диаметр 26px) -->
                            <Border x:Name="MiniPlayPauseBtn" Width="26" Height="26" CornerRadius="13" 
                                    Background="{DynamicResource AccentBrush}" 
                                    Cursor="Hand" Margin="2,0" VerticalAlignment="Center"
                                    MouseLeftButtonUp="OnMediaPlayPauseClick" ToolTip="Воспроизведение / Пауза">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="MiniPauseIcon" Fill="#FFFFFF" 
                                          Data="M 0,0 L 2.4,0 L 2.4,9 L 0,9 Z M 5.2,0 L 7.6,0 L 7.6,9 L 5.2,9 Z" 
                                          Width="8" Height="9" Stretch="Uniform" Visibility="Visible" SnapsToDevicePixels="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="MiniPauseScale" ScaleX="1" ScaleY="1" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <Path x:Name="MiniPlayIcon" Fill="#FFFFFF" 
                                          Data="M 0,0 L 8,4.5 L 0,9 Z" 
                                          Width="8" Height="9" Stretch="Uniform" Visibility="Collapsed" SnapsToDevicePixels="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="MiniPlayScale" ScaleX="1" ScaleY="1" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>

                            <!-- Кнопка Next -->
                            <Border x:Name="MiniNextBtn" Width="22" Height="22" CornerRadius="11" Background="Transparent" 
                                    Cursor="Hand" Margin="5,0,0,0" VerticalAlignment="Center"
                                    MouseLeftButtonUp="OnMediaNextClick" ToolTip="Следующий трек">
                                <Path Fill="#C8C8CD" Data="M 0,0.5 L 6.5,5 L 0,9.5 Z M 7,0.5 L 9,0.5 L 9,9.5 L 7,9.5 Z" 
                                      Width="9" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Справа: меню и эквалайзер из 7 столбиков -->
                    <Grid Grid.Column="4" VerticalAlignment="Center" Margin="0,0,2,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Три точки в правом верхнем углу -->
                        <TextBlock Grid.Row="0" Text="•••" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" 
                                   HorizontalAlignment="Right" Margin="0,0,0,8" Opacity="0.75" />

                        <!-- Анимированный эквалайзер в акцентном цвете темы (7 столбиков разной высоты) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <Border x:Name="EqBar1" Width="2.5" Height="6" Background="{DynamicResource AccentBrush}" CornerRadius="1.2" Margin="1,0" VerticalAlignment="Bottom" />
                            <Border x:Name="EqBar2" Width="2.5" Height="14" Background="{DynamicResource AccentBrush}" CornerRadius="1.2" Margin="1,0" VerticalAlignment="Bottom" />
                            <Border x:Name="EqBar3" Width="2.5" Height="9" Background="{DynamicResource AccentBrush}" CornerRadius="1.2" Margin="1,0" VerticalAlignment="Bottom" />
                            <Border x:Name="EqBar4" Width="2.5" Height="18" Background="{DynamicResource AccentBrush}" CornerRadius="1.2" Margin="1,0" VerticalAlignment="Bottom" />
                            <Border x:Name="EqBar5" Width="2.5" Height="12" Background="{DynamicResource AccentBrush}" CornerRadius="1.2" Margin="1,0" VerticalAlignment="Bottom" />
                            <Border x:Name="EqBar6" Width="2.5" Height="15" Background="{DynamicResource AccentBrush}" CornerRadius="1.2" Margin="1,0" VerticalAlignment="Bottom" />
                            <Border x:Name="EqBar7" Width="2.5" Height="7" Background="{DynamicResource AccentBrush}" CornerRadius="1.2" Margin="1,0" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 2. СТАНДАРТНЫЙ РЕЖИМ ЧЁЛКИ: Погода слева, Время по центру, Батарея справа (по фото) -->
                <Grid x:Name="IdleModeGrid" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IdleModeScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <!-- 0: Погода слева -->
                        <ColumnDefinition Width="*" />
                        <!-- 1: Время по центру -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 2: Батарея справа -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Погода слева: аккуратное облако + градус белым -->
                    <StackPanel x:Name="NotchWeatherPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                                Cursor="Hand" MouseLeftButtonUp="OnWeatherNotchClick" ToolTip="Открыть прогноз погоды">
                        <TextBlock x:Name="NotchWeatherIcon" Text="☁" FontSize="11" Foreground="{StaticResource WeatherCloudBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="NotchTempText" Text="+12°" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Помодоро слева (Live Activity): 🎯 / ☕ + таймер -->
                    <StackPanel x:Name="NotchPomoPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                                Cursor="Hand" MouseLeftButtonUp="OnPomoNotchClick" ToolTip="Открыть Помодоро" Visibility="Collapsed">
                        <TextBlock x:Name="NotchPomoIcon" Text="🎯" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <TextBlock x:Name="NotchPomoTimer" Text="24:50" FontSize="11.5" FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Время по центру: Крупное 01:12, Bold White (16.5px) -->
                    <TextBlock x:Name="NotchTimeText" Grid.Column="1" Text="01:12" FontSize="16.5" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonUp="OnTimeNotchClick" ToolTip="Открыть календарь" />

                    <!-- Батарея справа: иконка сверху, процент ПОД ней (в точности как на фото) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0">
                        <!-- Корпус аккумулятора -->
                        <Grid Width="19" Height="9.5" HorizontalAlignment="Center" Margin="0,0,0,1">
                            <!-- Внешняя рамка аккумулятора -->
                            <Border BorderBrush="#C8C8CD" BorderThickness="1.1" CornerRadius="2.5" Background="Transparent">
                                <!-- Заливка уровня заряда -->
                                <Border x:Name="NotchBatteryFill" Background="#FFFFFF" HorizontalAlignment="Left" 
                                        CornerRadius="1.2" Height="5.5" Width="10" Margin="1" />
                            </Border>
                            <!-- Плюсовой контакт аккумулятора справа -->
                            <Border Width="1.4" Height="3.2" Background="#C8C8CD" CornerRadius="0,0.6,0.6,0" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-2,0" />
                            <!-- Молния зарядки -->
                            <TextBlock x:Name="NotchChargingBolt" Text="⚡" FontSize="6.5" FontWeight="Bold" Foreground="#FFFFFF" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <!-- Процент заряда под батарейкой: 75% -->
                        <TextBlock x:Name="NotchBatteryText" Text="75%" FontSize="9.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 3. ПРЕМИАЛЬНАЯ КАПСУЛА-ИНДИКАТОР ПРИ ОТКРЫТЫХ ОКНАХ (Apple Home Bar / Dynamic Luminous Pill) -->
                <Grid x:Name="NotchBarContainer" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Opacity="0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False">
                    <!-- Мягкий рассеянный ореол свечения -->
                    <Border x:Name="NotchBarGlow"
                            Width="46" Height="3.2"
                            CornerRadius="1.6"
                            Background="#FFFFFF"
                            Opacity="0.45">
                        <Border.Effect>
                            <DropShadowEffect x:Name="NotchBarShadow" BlurRadius="8" ShadowDepth="0" Color="#FFFFFF" Opacity="0.55" RenderingBias="Performance" />
                        </Border.Effect>
                    </Border>
                    <!-- Основная световая полоска со сглаженными краями -->
                    <Border x:Name="NotchBarIndicator"
                            Width="46" Height="3.2"
                            CornerRadius="1.6">
                        <Border.Background>
                            <LinearGradientBrush x:Name="NotchBarBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#90FFFFFF" Offset="0.0" />
                                <GradientStop Color="#FFFFFF" Offset="0.5" />
                                <GradientStop Color="#90FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
