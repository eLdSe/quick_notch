<UserControl x:Class="QuickNotchCs.PomodoroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="710"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI Variable Display, Segoe UI">

    <UserControl.Resources>
        <!-- Кнопка выбора фазы -->
        <Style x:Key="PomoPhaseTabButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14" Padding="10,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка быстрой настройки минут -->
        <Style x:Key="PomoPresetButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вспомогательная круглая кнопка управления -->
        <Style x:Key="PomoSecondaryCircleButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="19" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Главная сетка: Bento 2 колонки -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="315" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== ЛЕВАЯ КОЛОНКА: ТАЙМЕР И УПРАВЛЕНИЕ ==================== -->
        <Border Grid.Column="0" Style="{StaticResource AppleGlassCardStyle}" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Выбор текущей фазы -->
                <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" CornerRadius="16" Padding="3" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FocusPhaseBtn" Style="{StaticResource PomoPhaseTabButton}" Content="🎯 Фокус" Click="OnFocusPhaseClick" />
                        <Button x:Name="ShortBreakPhaseBtn" Style="{StaticResource PomoPhaseTabButton}" Content="☕ Отдых" Click="OnShortBreakPhaseClick" />
                        <Button x:Name="LongBreakPhaseBtn" Style="{StaticResource PomoPhaseTabButton}" Content="🌴 Долгий" Click="OnLongBreakPhaseClick" />
                    </StackPanel>
                </Border>

                <!-- 2. Большой цифровой циферблат и прогресс -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Большой таймер -->
                    <TextBlock x:Name="TimerText" 
                               Text="25:00" 
                               FontSize="54" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,-4,0,0" />

                    <!-- Индикатор раунда и точек -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                        <TextBlock x:Name="RoundDotsText" Text="● ○ ○ ○" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="RoundInfoText" Text="Раунд 1 из 4" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Полоса прогресса текущей фазы -->
                    <Border Width="220" Height="5" CornerRadius="2.5" Background="#18FFFFFF" HorizontalAlignment="Center">
                        <Border x:Name="ProgressBarFill" 
                                HorizontalAlignment="Left" 
                                Width="0" 
                                Height="5" 
                                CornerRadius="2.5" 
                                Background="{DynamicResource AccentBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#0A84FF" Opacity="0.6" ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- 3. Кнопки управления -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Кнопка сброса -->
                        <Button x:Name="ResetBtn" 
                                Style="{StaticResource PomoSecondaryCircleButton}" 
                                Click="OnResetClick" 
                                ToolTip="Сбросить таймер"
                                Margin="0,0,12,0">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Главная кнопка Старт / Пауза -->
                        <Button x:Name="PlayPauseBtn" 
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Click="OnPlayPauseClick" 
                                Height="42" 
                                Width="120"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,12,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="21" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="glow" BlurRadius="12" Color="#0A84FF" Opacity="0.45" ShadowDepth="2" />
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHotBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PlayPauseIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="PlayPauseText" Text="Старт" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Кнопка пропустить фазу -->
                        <Button x:Name="SkipBtn" 
                                Style="{StaticResource PomoSecondaryCircleButton}" 
                                Click="OnSkipClick" 
                                ToolTip="Перейти к следующей фазе">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== ПРАВАЯ КОЛОНКА: НАСТРОЙКИ ВРЕМЕНИ ==================== -->
        <Border Grid.Column="2" Style="{StaticResource AppleGlassCardStyle}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок настроек -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Настройка интервалов времени" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Нажмите на нужные минуты для мгновенной установки" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Секции настроек -->
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <!-- 1. Время работы (Фокус) -->
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="10,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 " FontSize="11" />
                                    <TextBlock Text="Время фокуса" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="FocusValText" Text="25 мин" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource PomoPresetButton}" Content="15" Click="OnFocusPreset15" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="20" Click="OnFocusPreset20" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="25" Click="OnFocusPreset25" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="30" Click="OnFocusPreset30" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="45" Click="OnFocusPreset45" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="60" Click="OnFocusPreset60" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="-" Click="OnFocusMinus1" Margin="8,0,2,0" Width="26" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="+" Click="OnFocusPlus1" Width="26" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Короткий отдых -->
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="10,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☕ " FontSize="11" />
                                    <TextBlock Text="Короткий отдых" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="ShortValText" Text="5 мин" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource PomoPresetButton}" Content="3 мин" Click="OnShortPreset3" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="5 мин" Click="OnShortPreset5" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="10 мин" Click="OnShortPreset10" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="15 мин" Click="OnShortPreset15" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="-" Click="OnShortMinus1" Margin="8,0,2,0" Width="26" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="+" Click="OnShortPlus1" Width="26" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Длинный отдых -->
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="10,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌴 " FontSize="11" />
                                    <TextBlock Text="Длинный отдых" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="LongValText" Text="15 мин" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource PomoPresetButton}" Content="10 мин" Click="OnLongPreset10" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="15 мин" Click="OnLongPreset15" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="20 мин" Click="OnLongPreset20" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="30 мин" Click="OnLongPreset30" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="-" Click="OnLongMinus1" Margin="8,0,2,0" Width="26" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="+" Click="OnLongPlus1" Width="26" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4. Раунды -->
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Раундов до длинного отдыха" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Количество циклов концентрации" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PomoPresetButton}" Content="2" Click="OnRounds2" Width="30" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="3" Click="OnRounds3" Width="30" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="4" Click="OnRounds4" Width="30" />
                                <Button Style="{StaticResource PomoPresetButton}" Content="5" Click="OnRounds5" Width="30" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
