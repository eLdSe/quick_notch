<UserControl x:Class="QuickNotchCs.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="416" d:DesignWidth="808"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI Variable Display, Segoe UI">

    <UserControl.Resources>
        <!-- Стиль переключателя вкладок сегментов (использует активный акцент пользователя) -->
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="12" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки выбора опции (Тема, Язык и т.п.) -->
        <Style x:Key="ChoiceButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль переключателя Apple Switch -->
        <Style x:Key="AppleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bg" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Surface2Brush}" 
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Ellipse x:Name="thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вспомогательных кнопок действий -->
        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <!-- Стиль Apple Capsule Slider (тактильная капсула с акцентом) -->
        <Style x:Key="AppleSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="CapsuleBorder" CornerRadius="12" Background="#18FFFFFF" 
                                BorderBrush="#20FFFFFF" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate>
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="11,0,0,11" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="32" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <Border Width="5" Height="20" Background="White" CornerRadius="2.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.45" Color="Black" RenderingBias="Performance" />
                                                        </Border.Effect>
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate>
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapsuleBorder" Property="BorderBrush" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Основная сетка -->
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Сегментный переключатель вкладок в стиле macOS Settings -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                BorderThickness="1" CornerRadius="16" Padding="4" HorizontalAlignment="Center" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabAppearanceRadio" Style="{StaticResource SegmentButtonStyle}" 
                             Content="Оформление" IsChecked="True" Click="OnSubTabChanged" />
                <RadioButton x:Name="TabBackgroundRadio" Style="{StaticResource SegmentButtonStyle}" 
                             Content="Фон" Click="OnSubTabChanged" />
                <RadioButton x:Name="TabBehaviorRadio" Style="{StaticResource SegmentButtonStyle}" 
                             Content="Поведение" Click="OnSubTabChanged" />
                <RadioButton x:Name="TabSystemRadio" Style="{StaticResource SegmentButtonStyle}" 
                             Content="Система" Click="OnSubTabChanged" />
            </StackPanel>
        </Border>

        <!-- ==================== Вкладка 1: ОФОРМЛЕНИЕ ==================== -->
        <Grid Grid.Row="1" x:Name="AppearancePanel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Верхний ряд: Тема острова и Эффект стекла -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Карточка темы -->
                <Border Grid.Column="0" Style="{StaticResource AppleGlassCardStyle}" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Тема острова" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Светлый, тёмный или авто-режим" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" x:Name="ThemeDarkRadio" Style="{StaticResource ChoiceButtonStyle}" Content="Тёмная" Margin="0,0,4,0" Click="OnThemeDarkClick" />
                            <RadioButton Grid.Column="1" x:Name="ThemeLightRadio" Style="{StaticResource ChoiceButtonStyle}" Content="Светлая" Margin="2,0,2,0" Click="OnThemeLightClick" />
                            <RadioButton Grid.Column="2" x:Name="ThemeAutoRadio" Style="{StaticResource ChoiceButtonStyle}" Content="Авто" Margin="4,0,0,0" Click="OnThemeAutoClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Эффект матового стекла (Liquid Glass) -->
                <Border Grid.Column="2" Style="{StaticResource AppleGlassCardStyle}" Padding="12,8">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Эффект стекла" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Матовое стекло Liquid Glass" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="Apple Frosted Glass с глубиной" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="GlassCheckBox" Style="{StaticResource AppleSwitchStyle}" VerticalAlignment="Center" Click="OnGlassToggleClick" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Средний ряд: Палитра акцентных цветов во всю ширину -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Акцентный цвет" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Цвета подсветки и активных элементов" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" />
                    <WrapPanel x:Name="AccentColorsPanel" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Нижний ряд: Робот-компаньон Aero -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="12,8">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🤖 Робот-компаньон Aero" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Интерактивный питомец: следит за курсором и может летать по рабочему столу" 
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RoamButton" Content="🚀 Выпустить на рабочий стол" 
                            Style="{StaticResource SettingsActionButton}" Click="OnRoamClick" />
                    <CheckBox Grid.Column="3" x:Name="RobotCompanionCheckBox" Style="{StaticResource AppleSwitchStyle}" VerticalAlignment="Center" Click="OnRobotCompanionClick" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== Вкладка 2: ФОН ОСТРОВА ==================== -->
        <Grid Grid.Row="1" x:Name="BackgroundPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Карточка 1: Выбор файла обоев -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="18,14" Margin="0,0,0,8">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Фоновое изображение острова" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="BgFileText" Text="Фон не выбран" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BgClearButton" Content="Сбросить" Style="{StaticResource SettingsActionButton}" Margin="0,0,8,0" Click="OnBgClearClick" />
                        <Button x:Name="BgPickButton" Content="📁 Выбрать файл..." Style="{StaticResource SettingsActionButton}" Click="OnBgPickClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Карточка 2: Затемнение фона -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="18,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Затемнение фонового рисунка" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Регулировка яркости подложки под карточками" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="BgDimValueText" Text="55%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider Grid.Row="1" x:Name="BgDimSlider" Minimum="0" Maximum="0.9" Value="0.55" 
                            Style="{StaticResource AppleSliderStyle}" ValueChanged="OnBgLookChanged" />
                </Grid>
            </Border>

            <!-- Карточка 3: Размытие фона (Blur) -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Размытие фона (Gaussian Blur)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Мягкое матовое размытие обоев острова" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="BgBlurValueText" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider Grid.Row="1" x:Name="BgBlurSlider" Minimum="0" Maximum="20" Value="0" 
                            Style="{StaticResource AppleSliderStyle}" ValueChanged="OnBgLookChanged" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== Вкладка 3: ПОВЕДЕНИЕ ==================== -->
        <Grid Grid.Row="1" x:Name="BehaviorPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Способ вызова (Только чёлка) -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="18,14" Margin="0,0,0,8">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Способ вызова острова" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Остров раскрывается исключительно по нажатию на чёлку экрана" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,6">
                        <TextBlock Text="💻 Только чёлка" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Задержка автоматического скрытия -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Задержка скрытия (Auto-Collapse)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Время до сворачивания после ухода курсора" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="DelayValueText" Text="1.5 сек" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider Grid.Row="1" x:Name="DelaySlider" Minimum="0.5" Maximum="8.0" Value="1.5" 
                            Style="{StaticResource AppleSliderStyle}" ValueChanged="OnDelaySliderChanged" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== Вкладка 4: СИСТЕМА ==================== -->
        <Grid Grid.Row="1" x:Name="SystemPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Верхний ряд: Автозапуск и Язык интерфейса -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Автозапуск Windows -->
                <Border Grid.Column="0" Style="{StaticResource AppleGlassCardStyle}" Padding="12,8">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Запуск с Windows" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Автозагрузка при старте системы" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AutostartCheckBox" Style="{StaticResource AppleSwitchStyle}" VerticalAlignment="Center" Click="OnAutostartClick" />
                    </Grid>
                </Border>

                <!-- Язык интерфейса -->
                <Border Grid.Column="2" Style="{StaticResource AppleGlassCardStyle}" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Язык интерфейса" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Русский, English, Türkçe" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" x:Name="LangRuRadio" Style="{StaticResource ChoiceButtonStyle}" Content="🇷🇺 RU" Margin="0,0,4,0" Click="OnLangRuClick" />
                            <RadioButton Grid.Column="1" x:Name="LangEnRadio" Style="{StaticResource ChoiceButtonStyle}" Content="🇺🇸 EN" Margin="2,0,2,0" Click="OnLangEnClick" />
                            <RadioButton Grid.Column="2" x:Name="LangTrRadio" Style="{StaticResource ChoiceButtonStyle}" Content="🇹🇷 TR" Margin="4,0,0,0" Click="OnLangTrClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Средний ряд: Горячая клавиша -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="18,14" Margin="0,0,0,8">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Горячая клавиша активации" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Быстрое открытие и скрытие острова из любого приложения" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5">
                        <TextBlock Text="Ctrl + Alt + N" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Нижний ряд: О программе и кнопка теста уведомления -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18" Padding="18,14">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="QuickNotch v1.0.4  ·  macOS Dynamic Island для Windows" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Аппаратно-ускоренный движок WPF XAML (0% нагрузки на ЦП)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔔 Тест уведомления" Style="{StaticResource SettingsActionButton}" Padding="14,8" Click="OnTestNotificationClick" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
