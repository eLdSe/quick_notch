<UserControl x:Class="QuickNotchCs.TopBarView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             mc:Ignorable="d" 

             Height="40"

             TextOptions.TextFormattingMode="Display"

             TextOptions.TextRenderingMode="ClearType"

             FontFamily="Segoe UI Variable Display, Segoe UI">



    <UserControl.Resources>

        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1E" />

        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2C2C2E" />

        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282B" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />

        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />

        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />

        <SolidColorBrush x:Key="AccentHotBrush" Color="#FF375F" />

        <SolidColorBrush x:Key="GreenBrush" Color="#30D158" />



        <!-- Стиль круглой кнопки управления окном (свернуть/закрыть) -->

        <Style x:Key="WindowCircleButton" TargetType="Button">

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Width" Value="28" />

            <Setter Property="Height" Value="28" />

            <Setter Property="Foreground" Value="#8E8E93" />

            <Setter Property="Background" Value="#262629" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14" SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bg" Property="Background" Value="#3A3A3E" />

                                <Setter Property="Foreground" Value="White" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="bg" Property="Background" Value="#48484C" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Специальный стиль для кнопки закрытия с красным ховером -->

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCircleButton}">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14" SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bg" Property="Background" Value="#FF453A" />

                                <Setter Property="Foreground" Value="White" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="bg" Property="Background" Value="#D70015" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Стиль плавающей пилюли даты/времени -->

        <Style x:Key="TopBarPillButton" TargetType="Button">

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Height" Value="30" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15" Padding="10,0" SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#2AFFFFFF" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Премиальный стиль пилюли Аэро в шапке (Apple Glass Capsule с неоновым свечением) -->

        <Style x:Key="AeroPillButtonStyle" TargetType="Button">

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Background" Value="#181922" />

            <Setter Property="BorderBrush" Value="#2D3040" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Height" Value="30" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" 

                                BorderBrush="{TemplateBinding BorderBrush}" 

                                BorderThickness="{TemplateBinding BorderThickness}" 

                                CornerRadius="15" Padding="7,0,9,0" SnapsToDevicePixels="True">

                            <Border.Effect>

                                <DropShadowEffect x:Name="pillGlow" BlurRadius="14" ShadowDepth="1" Opacity="0.35" Color="#38BDF8" RenderingBias="Performance" />

                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#232635" />

                                <Setter TargetName="border" Property="BorderBrush" Value="#9938BDF8" />



                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#14151C" />

                                <Setter TargetName="border" Property="Opacity" Value="0.85" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>



    <Grid VerticalAlignment="Center">

        <Grid.ColumnDefinitions>

            <!-- Левая колонка: Дата/Время + Назад -->

            <ColumnDefinition Width="Auto" />

            <!-- Средняя колонка: Робот-питомец Аэро -->

            <ColumnDefinition Width="*" />

            <!-- Правая колонка: Батарея + Кнопки управления окном -->

            <ColumnDefinition Width="Auto" />

        </Grid.ColumnDefinitions>



        <!-- ==================== 1. ЛЕВАЯ ЧАСТЬ: ВРЕМЯ, ДАТА И КРОШКА ==================== -->

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Пилюля даты и времени (клик открывает Календарь) -->

            <Button x:Name="DatePillButton" Style="{StaticResource TopBarPillButton}" Click="OnDateClick" ToolTip="Открыть календарь">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock x:Name="TimeText" Text="16:10" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock x:Name="DateText" Text=" •  Среда, 28 октября" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,1,0,0" />

                </StackPanel>

            </Button>



            <!-- Кнопка «‹ Назад • Раздел», если открыт не Home -->

            <Button x:Name="BreadcrumbButton" Style="{StaticResource TopBarPillButton}" Click="OnBreadcrumbClick" Margin="6,0,0,0" Visibility="Collapsed">

                <Border Background="#262629" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="10,3">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="‹ " FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentHotBrush}" />

                        <TextBlock x:Name="BreadcrumbText" Text="Назад" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

                    </StackPanel>

                </Border>

            </Button>

        </StackPanel>



        <!-- ==================== 2. СРЕДНЯЯ ЧАСТЬ: КАПСУЛА АЭРО ==================== -->

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Интерактивная капсула Аэро (клик выпускает на рабочий стол или возвращает в остров) -->

            <Button x:Name="AeroPillButton" 

                    Style="{StaticResource AeroPillButtonStyle}" 

                    Click="OnAeroIconClick" 

                    ToolTip="Выпустить Аэро на рабочий стол"

                    FocusVisualStyle="{x:Null}">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Иконка робота с неоновым свечением -->

                    <Border Width="20" Height="20" CornerRadius="10" Background="#1E2436" BorderBrush="#3538BDF8" BorderThickness="1" 

                            Margin="0,0,6,0" SnapsToDevicePixels="True">

                        <TextBlock x:Name="AeroIconSymbol" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0" />

                    </Border>

                    <!-- Имя робота -->

                    <TextBlock x:Name="AeroNameText" Text="Аэро" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <!-- Светящийся огонёк активности -->

                    <Ellipse x:Name="AeroOnlineIndicator" Width="5.5" Height="5.5" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0">

                        <Ellipse.Effect>

                            <DropShadowEffect x:Name="AeroIndicatorGlow" BlurRadius="6" ShadowDepth="0" Color="#30D158" Opacity="0.8" RenderingBias="Performance" />

                        </Ellipse.Effect>

                    </Ellipse>

                    <!-- Стрелочка действия в круглом микро-контейнере -->

                    <Border Width="16" Height="16" CornerRadius="8" Background="#262834" VerticalAlignment="Center" SnapsToDevicePixels="True">

                        <TextBlock x:Name="AeroArrowSymbol" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                </StackPanel>

            </Button>

        </StackPanel>



        <!-- ==================== 3. ПРАВАЯ ЧАСТЬ: БАТАРЕЯ И КНОПКИ ОКНА ==================== -->

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Чип батареи -->

            <Border x:Name="BatteryChip" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Height="28" Padding="10,0" Margin="0,0,10,0">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Иконка батареи -->

                    <Grid Width="22" Height="11" Margin="0,0,6,0" VerticalAlignment="Center">

                        <!-- Корпус -->

                        <Border BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="2.5" Background="Transparent">

                            <!-- Заполнение уровня заряда -->

                            <Border x:Name="BatteryFill" Background="{StaticResource GreenBrush}" HorizontalAlignment="Left" CornerRadius="1" Width="16" Margin="1" />

                        </Border>

                        <!-- Плюсовой контакт справа -->

                        <Border Width="1.5" Height="4" Background="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-2.5,0" CornerRadius="0.5" />

                        <!-- Молния, если заряжается -->

                        <TextBlock x:Name="ChargingBolt" Text="⚡" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                    </Grid>

                    <!-- Текст процента -->

                    <TextBlock x:Name="BatteryPercentText" Text="87%" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                </StackPanel>

            </Border>



            <!-- Кнопка «Свернуть остров» -->

            <Button x:Name="CollapseButton" Style="{StaticResource WindowCircleButton}" Click="OnCollapseClick" Margin="0,0,6,0" ToolTip="Свернуть остров">

                <TextBlock Text="⌃" FontSize="14" FontWeight="Bold" Margin="0,-3,0,0" />

            </Button>



            <!-- Кнопка «Закрыть» -->

            <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}" Click="OnCloseClick" ToolTip="Закрыть QuickNotch">

                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />

            </Button>

        </StackPanel>

    </Grid>

</UserControl>

